# Comma-separated keys accepted on the X-API-Key header
API_KEYS=

# Primary auth path: cookies copied from a logged-in session
LI_AT=
LI_JSESSIONID=

# Fallback auth path: programmatic login. Currently answered with a CAPTCHA challenge.
LI_USERNAME=
LI_PASSWORD=

# Opt in to the authenticated Voyager path. Off by default: a session survives only a
# handful of requests and can only be refreshed by a human with a browser.
VOYAGER_ENABLED=false

SESSION_PATH=/data/session.json
CACHE_TTL_SECONDS=21600
OUTBOUND_RATE_SECONDS=30
INBOUND_RATE_PER_MINUTE=20
